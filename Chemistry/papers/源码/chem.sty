% chem.sty —— 上海高中化学试卷共享样式
%
% 与 Mathematics/papers/源码/common.sty 采用同一套「单文件双输出」机制：
%   试卷版：xelatex 试卷.tex
%   答案版：xelatex "\def\isanswer{1}\input{试卷.tex}"
%
% 依赖：xelatex + ctex（fontset=mac 需 macOS 中文字体）、chemformula、tikz。

% ---- 中文与字体 ----
\RequirePackage[UTF8, fontset=mac, scheme=plain]{ctex}
\setmainfont{Times New Roman}

% 下列字符不在 xeCJK 默认 CJK 字符范围内，会落到西文字体（Times New Roman）
% 上导致字形丢失（Missing character），显式划入 CJK 类交给中文字体渲染：
%   U+2460–U+24FF  圈数字 ①②③…
%   U+2160–U+217F  罗马数字 Ⅰ Ⅱ Ⅲ…（原卷「方案Ⅰ/方案Ⅱ」用）
%   U+2100–U+214F  字母式符号 ℃ ℉ № …
\xeCJKDeclareCharClass{CJK}{"2460 -> "24FF, "2160 -> "217F, "2100 -> "214F}

% ---- 版面 ----
\RequirePackage[a4paper,left=2.2cm,right=2.2cm,top=2.4cm,bottom=2.4cm]{geometry}
\RequirePackage{setspace}\setstretch{1.35}

% 允许段落末尾额外拉伸，避免「长题干 + 填空横线」把最后一行顶出右边界（Overfull \hbox）。
% 中文段落几乎没有可伸长的词间空格，仅靠 \tolerance 无法化解，故给出 2em 的应急余量。
\setlength{\emergencystretch}{2em}

% ---- 数学与化学符号 ----
\RequirePackage{amsmath,amssymb}
\RequirePackage{chemformula}

% ---- 排版宏包 ----
\RequirePackage{enumitem}
\setlist[enumerate]{leftmargin=2.2em,itemsep=0.35em,topsep=0.4em}
\RequirePackage{array,tabularx,booktabs,longtable}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,positioning,calc}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{ulem}
\RequirePackage{multirow}

% ---- 页眉页脚骨架（左侧卷名由各试卷 \fancyhead[L] 自行指定）----
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% ==========================================================
% 试卷版 / 答案版 控制
% ==========================================================
\newif\ifanswer
\answerfalse
\DeclareOption{answer}{\answertrue}
\DeclareOption{test}{\answerfalse}
\ExecuteOptions{test}
\ProcessOptions\relax
% 也支持在 \input 主文件前 \def\isanswer{1}
\ifdefined\isanswer\answertrue\fi

% 版本标记：仅答案版在页眉追加，便于打印后区分两摞纸
\newcommand{\vermark}{\ifanswer\quad【参考答案版】\fi}

% 行内答案 / 解析（备用于把答案直接挂在题目后面；本卷答案集中在卷末）
\newcommand{\ans}[1]{\ifanswer\par\noindent{\small\kaishu\bfseries 【答案】}#1\fi}
\newcommand{\sol}[1]{\ifanswer\par\noindent{\small\kaishu\bfseries 【解析】}#1\fi}

% ==========================================================
% 题型排版命令
% ==========================================================
% 填空横线
\newcommand{\blank}[1][2.2em]{\underline{\hspace{#1}}}

% 四选项（注意：行首 \par 换行，行尾不可再添 \par，否则会打断 enumerate 的 item）
\newcommand{\choice}[4]{\par\hangindent=2em A.~#1 \quad B.~#2 \quad C.~#3 \quad D.~#4}
% 三选项版本（原题无 D 选项时使用）
\newcommand{\choicethree}[3]{\par\hangindent=2em A.~#1 \quad B.~#2 \quad C.~#3}
% 选项较长时改用下面两个：\choicepairs 每行两项，\choicelines 每行一项。
% 同样以 \par 开头、结尾不加 \par，避免打断 enumerate 的 \item。
\newcommand{\choicepairs}[4]{%
  \par\noindent A.~#1 \quad B.~#2\par\noindent C.~#3 \quad D.~#4}
\newcommand{\choicelines}[4]{%
  \par\noindent A.~#1\par\noindent B.~#2\par\noindent C.~#3\par\noindent D.~#4}

% 大题标题（一、/二、/三、）
\newcommand{\bigsection}[1]{\par\vspace{0.6em}{\kaishu\large\bfseries #1}\par\vspace{0.2em}}

% ---- 解答题作答留白（仅试卷版显示）----
% \ansspace[n] / \ansspace*[n]：预留 n 行书写空白（默认 4 行，行高 1.2cm）。
% 前 3 行用不可丢弃的 0 宽支撑盒（分页时不会被扔掉，保证最低限度书写空间），
% 其余行数用可丢弃胶水 \vspace（分页时自动消失，绝不顶出一页白纸）。
% 每份卷子的最后一题请用 * 版，因为其后已无内容，支撑盒一旦溢出就是一张白纸。
% 本卷题目基本沿用原卷的填空横线，故仅在需要整段演算时按需调用。
\newcount\ansspace@n
\newdimen\ansspace@skip
\newcommand{\ansspace}{\@ifstar\ansspace@soft\ansspace@hard}
\newcommand{\ansspace@glue}{%
  \ansspace@skip=\baselineskip
  \multiply\ansspace@skip by \ansspace@n
  \vspace{\ansspace@skip}%
}
\newcommand{\ansspace@hard}[1][4]{%
  \ifanswer\else
    \par\vspace{0.5em}%
    \begingroup
      \baselineskip=1.2cm
      \ansspace@n=#1\relax
      \ifnum\ansspace@n<3 \ansspace@n=3 \fi
      \advance\ansspace@n by -3
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \ifnum\ansspace@n>0 \ansspace@glue\fi
    \endgroup
  \fi
}
\newcommand{\ansspace@soft}[1][4]{%
  \ifanswer\else
    \par\vspace{0.5em}%
    \begingroup
      \baselineskip=1.2cm
      \ansspace@n=#1\relax
      \ansspace@glue
    \endgroup
  \fi
}
