% papers/源码/common.sty —— 上海高一数学周末作业共享样式
% 需要 ctex、amsmath、amssymb、enumitem、geometry

\RequirePackage{ctex}
\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{extarrows}
\RequirePackage{tikz}

% ===== 圈数字符 ①②③…（U+2460–U+24FF）=====
% 该区段（Enclosed Alphanumerics）不在 xeCJK 默认的 CJK 字符范围内，
% 于是会落到西文字体 lmroman 上，而 lmroman 没有这些字形 —— 编译时报
%   Missing character: There is no ① (U+2460) in font [lmroman10-regular]
% 结果是题目里的 ①②③ 被静默丢弃（PDF 中直接消失、不报错、不留白）。
% 显式划入 CJK 字符类，改由中文字体（宋体）渲染，字形完整。
% 同理，罗马数字 Ⅰ Ⅱ Ⅲ（U+2160–U+217F，常见于“方案Ⅰ/方案Ⅱ”“（Ⅰ）（Ⅱ）”）
% 与字母式符号 ℃ ℉ №（U+2100–U+214F，常见于“温度/℃”轴标签）也不在默认 CJK
% 范围内，同样会被静默丢弃。三个区间一次划清，避免逐轮踩坑。
% 注：现有 26 份数学卷源码里，圈数字在正文（不含 % 注释）里用了 588 次、遍布 25 份
%     （只有高一06 一份没用），本行主要是在为它兜底。
%
% 2026-09-15 补两段，给“溯源”报告（源码/溯源.tex，由 工具/README转tex.py 生成）用：
%   · U+25A0–U+25FF（Geometric Shapes）：▲ ■ ● 等，报告里用 ▲ 标“本轮新增或改判”；
%   · U+2600–U+26FF（Miscellaneous Symbols）：★ ☆ 等，报告里用 ★ 标“重跑新增”。
%   这两个字在试卷里没出现、报告里出现了 26／25 次，不划进 CJK 就会被静默丢掉。
\xeCJKDeclareCharClass{CJK}{"2460 -> "24FF, "2160 -> "217F, "2100 -> "214F,
                             "25A0 -> "25FF, "2600 -> "26FF}

% 中文标点
\AtBeginDocument{\xeCJKsetup{CJKecglue={\hskip 0.15em plus 0.05em}}}

% ===== 可复现构建：把 PDF 的 /Creator 钉死（2026-09-28）=====
% XeTeX 默认往 /Creator 写**编译时刻、精确到分**（如“ XeTeX output 2026.09.29:0654”），
% 而这一项**不归 SOURCE_DATE_EPOCH 管**——于是同一份源码跨一分钟重编，PDF 就多出几字节差异
% （实测只差 4 个字节、正文与像素完全相同，但足以让 git 里冒出假 diff）。
% 这里用 pdf:docinfo special 覆盖成固定串（xdvipdfmx 认这个 special，写在 \AtBeginDocument 即可）；
% 日期那一半由 源码/Makefile 的 SOURCE_DATE_EPOCH 负责（它还管着 /ID）——两者合起来才是
% “源码不变 ⇒ PDF 逐字节相同”。溯源报告那份本来就不受影响：它载入了 hyperref，
% /Creator 早已被 hyperref 写成固定的“LaTeX with hyperref”。
% 计数核对.py 有一条断言盯着这里还在不在（口令：可复现构建）。
% 串里只用 ASCII（`special` 的内容进 PDF 字符串，放宏会被原样展开成乱码——踩过）。
\AtBeginDocument{\special{pdf:docinfo<</Creator(Mathematics/papers - XeLaTeX)>>}}

% 试卷版/答案版控制
% 用法 1（命令行，本仓库 Makefile 的 ans / one 目标走的就是这条）：
%        xelatex "\def\isanswer{1}\input{高一06_延安中学_周末作业1.tex}"
% 用法 2（源码顶部）：\def\isanswer{1}  然后再 \input 主文件
\newif\ifanswer
\answerfalse
\DeclareOption{answer}{\answertrue}
\DeclareOption{test}{\answerfalse}
% 紧凑版开关（第三版输出）：\def\iscompact{1} 时试卷版不再输出解答题作答区。
%   · 只影响 \ansspace（硬/软两版都归零）——题面、题号、插图、副标题一字不动；
%   · \ansneed（压轴题前的换页保护）在紧凑模式下**也不生效**：实测保留它 19 份合计 46 页、
%     去掉则 42 页——紧凑版以“最短”为目标，代价是压轴题可能被跨页切开（试卷版不受影响）；
%   · 答案版本来就没有作答区，故不受影响、也不需要紧凑版。
\newif\ifcompact
\compactfalse
\DeclareOption{compact}{\compacttrue}
\ExecuteOptions{test}
\ProcessOptions\relax
\ifdefined\isanswer\answertrue\fi
\ifdefined\iscompact\compacttrue\fi

% 填空横线
\newcommand{\blankline}[1][3em]{\underline{\hspace{#1}}}

% 标题（可选参数 = 标题字号档位，默认 2 号；长标题可传 3）
\newcommand{\examtitlest}[3][2]{%
  \begin{center}
    {\zihao{#1}\bfseries #2}\\[0.3em]
    {\zihao{4}\rmfamily #3}
  \end{center}%
}

% \needvspace{dim}：若本页剩余高度不足 dim，就先另起一页。
% 节标题靠它避免孤零零落在页末——试卷版里作答区是可丢弃胶水，挡不住标题落页底，
% 故**三版都加这道守卫**（只影响分页，不动一个字）。
\newcommand{\needvspace}[1]{%
  \par
  \begingroup
    \dimen@=#1\relax
    \ifdim\pagegoal<\maxdimen
      \advance\dimen@ by \pagetotal
      \ifdim\dimen@>\pagegoal \newpage \fi
    \fi
  \endgroup
  \par
}

% \keepwithprev{dim}：禁止在“上一段与本段之间”分页。
% 用在**选择题的选项段**之前——不让 A/B/C/D 与题干分家（高一07 第 16 题原来就分家了：
% 题干在页末、四个选项整页翻过去）。真放不下时 TeX 会把题干连选项一起挪到次页；
% 三版都生效（答案版同样受益，且不影响答案与解析的排布）。
\newcommand{\keepwithprev}{\nopagebreak[4]}

% 大节标题（一、/二、/三、）
\newcommand{\bigsec}[1]{%
  \needvspace{3\baselineskip}%
  \par\vspace{0.5em}\noindent{\zihao{4}\bfseries #1}\par\vspace{0.2em}%
}

% 子小节
\newcommand{\smallsec}[1]{%
  \needvspace{2.5\baselineskip}%
  \par\noindent{\zihao{-4}\bfseries #1}\par\vspace{0.1em}%
}

% 解答题使用 enumerate
\setlist[enumerate,1]{label=\arabic*.,leftmargin=*,topsep=0.3em,itemsep=0.3em}

% ===== 答案版：答案与解析的分步排版 =====
% 答案版读起来吃力的根源不在内容，而在“形状”：一条解析被写成一个几百字的连续
% 段落，读者看不出解题分几步、每步在干什么。这里统一做三件事——
%   ① 标签 + 悬挂缩进：【答案】【解析】 贴在段首，正文整体右移，换行时与正文
%      左端对齐，标签不会再和正文糊在一起；
%   ② 解析切步：一个 \step 独占一段，段间留 0.16em 呼吸空间，行首挂一枚浅色小
%      方块，一眼可数清有几步（方块用 \rule 画，不依赖任何字体里有没有该字形）；
%   ③ 子题标号另起样式：以 (1)(2)① 开头的步骤交给 \stepm，标号加粗着色、正文
%      悬挂对齐，与普通步骤区分开。
% 颜色取深钢蓝：灰度打印时仍与黑色正文有明度差，不会糊成一片。
\definecolor{solblue}{RGB}{31,78,121}
\definecolor{solmark}{RGB}{152,176,201}

% \ans{答案}：标签在段首，续行悬挂对齐到答案正文左端
\newcommand{\ans}[1]{\ifanswer
  \begingroup
    \par\addvspace{0.30em}%
    \hangindent=4.4em \hangafter=1
    \noindent{\bfseries\color{solblue}【答案】}\hspace{0.35em}#1\par
  \endgroup
\fi}

% \solbegin … \solend：解析块。块内所有 \step 共享同一层缩进。
\newcommand{\solbegin}{\ifanswer
  \par\addvspace{0.40em}%
  \begingroup
    \parindent=0pt
    \hangindent=0pt
    \leftskip=1.5em
    \emergencystretch=1.2em
    \noindent\hspace*{-1.5em}{\bfseries\color{solblue}【解析】}\par
    \nopagebreak
    \vspace{0.14em}%
    \nopagebreak
\fi}
\newcommand{\solend}{\ifanswer\par\endgroup\fi}

% \step{一步}：普通解题步骤，行首悬挂浅色方块
\newcommand{\step}[1]{\ifanswer
  \par\addvspace{0.16em}\hangindent=0pt\hangafter=1
  \noindent\llap{\textcolor{solmark}{\rule[0.26em]{0.34em}{0.34em}}\hspace{0.60em}}%
  #1\par
\fi}

% \stepm{(1)}{一步}：带子题标号的步骤，标号加粗着色，正文悬挂对齐
\newcommand{\stepm}[2]{\ifanswer
  \par\addvspace{0.16em}\hangindent=2.05em\hangafter=1
  \noindent{\bfseries\color{solblue}#1}\hspace{0.35em}#2\par
\fi}

% 兼容旧写法（旧稿里 \sol 后接一段连续文字）
\newcommand{\sol}{\solbegin}

% ===== 解答题作答留白（仅试卷版显示）=====
% \ansspace[n]   在解答题末尾预留 n 行书写空间（默认 4 行，行高 1.2cm）
% \ansspace*[n]  同上，但整段改用“可丢弃胶水”，用于每份卷子的最后一题
%
% 两种写法分两段拼出留白，动机如下：
%   ① 前 3 行用 0 宽支撑盒（\rule）：盒子属于实打实的内容，分页时不会被丢弃，
%      保证题目哪怕正好卡在页底，也还留得下最低限度的书写空间；
%   ② 其余行数用 \vspace 胶水：胶水是可丢弃项，一旦遇上分页会被 TeX 直接扔掉。
%      正因如此，留白绝不会把后续内容顶到下一页，也就不会在卷末多出一张
%      只有页码的空白页——这正是最初用“整块支撑盒”时踩到的坑。
%   ③ 最后一题必须用 * 版：它后面已无内容，任何不可丢弃的支撑盒一旦溢出，
%      都会单独占据一整页而印出一张白纸。
\newcount\ansspace@n
\newdimen\ansspace@skip
\newcommand{\ansspace}{\@ifstar\ansspace@soft\ansspace@hard}
\newcommand{\ansspace@glue}{%
  \ansspace@skip=\baselineskip
  \multiply\ansspace@skip by \ansspace@n
  \vspace{\ansspace@skip}%
}
\newcommand{\ansspace@hard}[1][4]{%
  \ifanswer\else\ifcompact\else
    \par\vspace{0.5em}%
    \begingroup
      \baselineskip=1.2cm
      \ansspace@n=#1\relax
      \ifnum\ansspace@n<3 \ansspace@n=3 \fi
      \advance\ansspace@n by -3
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \noindent\rule{0pt}{0.92\baselineskip}\par
      \ifnum\ansspace@n>0 \ansspace@glue\fi
    \endgroup
  \fi\fi
}
\newcommand{\ansspace@soft}[1][4]{%
  \ifanswer\else\ifcompact\else
    \par\vspace{0.5em}%
    \begingroup
      \baselineskip=1.2cm
      \ansspace@n=#1\relax
      \ansspace@glue
    \endgroup
  \fi\fi
}
% \ansneed{dim}：若本页剩余高度不足 dim，就先另起一页（**仅试卷版、且非紧凑版**生效）。
% 只用在每份卷子的压轴题之前：压轴题往往最需要版面，而它的作答区是“可丢弃胶水”，
% 若正好落在页底会被整段丢掉。
% 答案版不做此调整，以免改变已定稿答案稿的分页（节标题那处守卫是另一回事，三版都在用）。
\newcommand{\ansneed}[1]{\ifanswer\else\ifcompact\else\needvspace{#1}\fi\fi}

