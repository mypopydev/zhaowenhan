# LaTeX 编译临时文件
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.bbl
*.blg

# Python 缓存（数学的工具脚本：跑 py_compile 或 import 后会生成 __pycache__ 与 .pyc）
__pycache__/
*.py[cod]

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 大型参考 PDF（教材/手册，不入库）
*词汇用法手册*.pdf
*课程标准*.pdf

# 构建产物（由 Makefile 生成，见 English/vocabulary/Makefile）
English/vocabulary/dist/

# 数学试卷源码目录的编译中间 PDF（成品位于 Mathematics/papers/试卷 与 答案）
Mathematics/papers/源码/*.pdf

# 化学试卷源码目录的编译中间 PDF（成品位于 Chemistry/papers/试卷 与 答案）
Chemistry/papers/源码/*.pdf
